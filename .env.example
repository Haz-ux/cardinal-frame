# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_NEMOTRON_API_KEY: Required for Nvidia Nemotron model query and listing discovery API.
# Users configure this via the Secrets panel in the AI Studio UI.
NVIDIA_NEMOTRON_API_KEY="MY_NVIDIA_PORTAL_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Cardinal Frame API Keys ──────────────────────────────────────
# These are read from the environment at runtime. Never commit real values.
# Copy this file to .env and fill in your keys.

# LLM Providers
NVIDIA_API_KEY=""
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Search (used by web-research and fact-check skills)
TAVILY_API_KEY=""

# Shopify (used by shopify-* skills)
SHOPIFY_SHOP_DOMAIN=""          # e.g. your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=""         # Admin API access token

# GitHub (used by agent git_op tool)
GITHUB_TOKEN=""

# Stripe (used by future billing skills)
STRIPE_SECRET_KEY=""

# Figma (used by future design import skills)
FIGMA_API_TOKEN=""

